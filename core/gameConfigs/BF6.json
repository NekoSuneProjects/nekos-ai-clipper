{
  "id": "BF6",
  "name": "Battlefield 6",
  "fps": 4,
  "ocrThreshold": 185,
  "_calibration": "BF6 personal kill callouts render CENTER-screen: skull + score, a medal name above (INTERCEPTOR/PROTECTOR/SPEARHEAD/etc.), victim name below, and a KILL / HEADSHOT / DOUBLE KILL / QUAD KILL / VEHICLE DESTROYED tag at the bottom. Crops scan that central band; the left kill-feed is excluded so only YOUR kills count. ocrThreshold binarizes the white callout text. Synced to BF6 gameplay 2026-06.",
  "crops": {
    "KillMessage": [0.25, 0.46, 0.75, 0.66],
    "StreakMessage": [0.25, 0.44, 0.75, 0.64],
    "GameResult": [0.30, 0.10, 0.70, 0.42]
  },
  "windows": {
    "killFuture": 2,
    "squadFuture": 2,
    "endGameFuture": 2,
    "streakLookbehind": 0,
    "streakLookahead": 8
  },
  "detectors": {
    "kill": [
      { "event": "kill", "match": ["KILL"], "score": 76 },
      { "event": "headshot", "match": ["HEADSHOT"], "score": 78 },
      { "event": "vehiculeDestroyed", "match": ["VEHICLE DESTROYED", "VEHICULE DESTROYED"], "score": 70 }
    ],
    "streak": [
      { "event": "doubleKill", "match": ["DOUBLE KILL", "DOUBLE"], "score": 72 },
      { "event": "tripleKill", "match": ["TRIPLE KILL", "TRIPLE"], "score": 72 },
      { "event": "quadraKill", "match": ["QUAD KILL", "QUAD", "OUAD"], "score": 72 },
      { "event": "knifeKill", "match": ["EXECUTIONER"], "score": 80 },
      { "event": "reaperMode", "match": ["MARAUDER"], "score": 80 }
    ],
    "squadWipe": [
      { "event": "squadWipe", "match": ["SQUAD WIPE"], "score": 78 }
    ],
    "endGame": [
      { "event": "victory", "crop": "GameResult", "match": ["VICTORY"], "score": 74 }
    ]
  },
