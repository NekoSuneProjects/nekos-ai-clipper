{
  "id": "FRTN",
  "name": "Fortnite",
  "fps": 2,
  "_calibration": "Robust central-zone scan: Fortnite's PERSONAL kill callouts appear roughly center-screen, while streamer overlays/cams sit at the edges — so we scan two broad central bands (top-center 'XpCallout' and center-bottom 'CenterCallout') plus the center 'GameResult' for Victory. This covers both PS5/chiaki (callouts on the right) AND PC streams (callouts center). ocrThreshold binarizes so the stylized font reads; keyword matching finds text anywhere in the band. The lobby kill-feed (left edge) is intentionally OUTSIDE these crops so we only catch YOUR kills. Coords are fractions [x1,y1,x2,y2]; retune per layout with the calibration tool.",
  "ocrThreshold": 185,
  "crops": {
    "XpCallout": [
      0.45,
      0.16,
      0.84,
      0.54
    ],
    "CenterCallout": [
      0.26,
      0.55,
      0.72,
      0.80
    ],
    "GameResult": [
      0.28,
      0.10,
      0.72,
      0.42
    ]
  },
  "windows": {
    "killFuture": 1,
    "squadFuture": 1,
    "endGameFuture": 1,
    "streakLookbehind": 0,
    "streakLookahead": 8
  },
  "deathWords": [
    "YOU PLACED",
    "PLACED #"
  ],
  "detectors": {
    "kill": [
      { "event": "kill", "crop": "XpCallout", "match": ["ENEMY ELIMINATED", "ELIMINATED", "ELIMINATION"], "score": 66 },
      { "event": "knockDown", "crop": "XpCallout", "match": ["KNOCKED"], "score": 64 },
      { "event": "kill", "crop": "CenterCallout", "match": ["ELIMINATED"], "score": 66 },
      { "event": "knockDown", "crop": "CenterCallout", "match": ["KNOCKED"], "score": 64 }
    ],
    "streak": [
      { "event": "doubleKill", "crop": "CenterCallout", "match": ["DOUBLE ELIM", "DOUBLE"], "score": 64 },
      { "event": "tripleKill", "crop": "CenterCallout", "match": ["TRIPLE ELIM", "TRIPLE"], "score": 64 }
    ],
    "squadWipe": [
      { "event": "squadWipe", "crop": "CenterCallout", "match": ["ENEMY TEAM WIPED", "TEAM WIPED"], "score": 64 }
    ],
    "endGame": [
      { "event": "victory", "crop": "GameResult", "match": ["VICTORY ROYALE", "#1 VICTORY", "VICTORY"], "score": 72 }
    ]
  },
