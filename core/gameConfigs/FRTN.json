{
  "id": "FRTN",
  "name": "Fortnite",
  "fps": 2,
  "_calibration": "Calibrated against ChisdealHDYT's PS5 (chiaki-ng) 1920x1026 footage on 2026-06-11. Crops target Fortnite's PERSONAL kill callouts (which only show when YOU get the kill), not the lobby feed. ocrThreshold binarizes the crop so the stylized italic font reads. Coords are fractions [x1,y1,x2,y2]. If your HUD scale/resolution differs, retune via the calibration tool.",
  "ocrThreshold": 185,
  "crops": {
    "ElimBanner": [
      0.56,
      0.24,
      0.87,
      0.58
    ],
    "MultiKill": [
      0.33,
      0.58,
      0.67,
      0.78
    ],
    "GameResult": [
      0.28,
      0.10,
      0.72,
      0.40
    ]
  },
  "windows": {
    "killFuture": 1,
    "squadFuture": 1,
    "endGameFuture": 1,
    "streakLookbehind": 0,
    "streakLookahead": 8
  },
  "deathWords": [
    "YOU PLACED",
    "PLACED #",
    "KNOCKED OUT"
  ],
  "detectors": {
    "kill": [
      { "event": "kill", "crop": "ElimBanner", "match": ["ENEMY ELIMINATED", "ELIMINATION", "ELIMINATED"], "score": 70 },
      { "event": "knockDown", "crop": "ElimBanner", "match": ["KNOCKED"], "score": 62 }
    ],
    "streak": [
      { "event": "doubleKill", "crop": "MultiKill", "match": ["DOUBLE ELIM", "DOUBLE"], "score": 64 },
      { "event": "tripleKill", "crop": "MultiKill", "match": ["TRIPLE ELIM", "TRIPLE"], "score": 64 }
    ],
    "squadWipe": [
      { "event": "squadWipe", "crop": "MultiKill", "match": ["ENEMY TEAM WIPED", "TEAM WIPED"], "score": 64 }
    ],
    "endGame": [
      { "event": "victory", "crop": "GameResult", "match": ["VICTORY ROYALE", "#1 VICTORY", "VICTORY"], "score": 72 }
    ]
  },
